<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bubble_system_bg">
        <TextView android:id="@+id/tvText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/bubble_system_text" android:textSize="11sp"/>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
