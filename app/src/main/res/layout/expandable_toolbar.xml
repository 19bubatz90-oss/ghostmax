<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/colorPrimaryDark">
    <Button android:id="@+id/togglePanel" android:text="▼ Filter und Modelle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark" android:textColor="#FFFFFF" android:padding="8dp"/>
    <LinearLayout android:id="@+id/panelContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
        <Spinner android:id="@+id/filterSpinner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <Spinner android:id="@+id/modelSpinner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <Spinner android:id="@+id/personalitySpinner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
